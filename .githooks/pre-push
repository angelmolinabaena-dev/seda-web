#!/usr/bin/env sh
# Pre-push hook: refuse to push directly to `main`.
#
# `main` auto-deploys to production via the Vercel <-> GitHub
# integration.
#
# This hook is NOT the gate. The gate is server-side: as of 2026-09-20
# this repo is public and `main` has an active GitHub ruleset named
# `web` (it requires a PR; read with the GitHub API on 2026-09-19 and
# 2026-09-20 — not reproducible from a checkout without `gh` auth).
# Per docs/GUARDARRAILES.md the ruleset has no bypass_actors, but the
# classic branch protection has enforce_admins=false, so whether an
# admin's direct push is refused server-side is not promised here.
#
# What this hook adds is a local shortcut: it stops the push here,
# before the round trip to GitHub and before a rejection you then have
# to read. It is a shortcut, not a substitute for anything.
#
# Known gaps that nobody covers today: it doesn't run for anyone who
# hasn't had `npm install` wire up core.hooksPath (the `prepare` script,
# scripts/setup-hooks.mjs; a fresh clone before install has nothing),
# and it never sees a PR merge — `gh pr merge` / the "Merge pull
# request" button are API calls, no hook involved. A detective workflow
# for those two (main-push-guard.yml) existed and was retired on
# 2026-08-09 (d4481f4, #43) because the server-side protection does the
# job; it is not being restored.
#
# The real flow is: open a PR, then `gh pr merge --squash`.
#
# Bypass in an actual emergency with `git push --no-verify`. Documented
# here on purpose, same as .githooks/pre-commit's bypass — hiding it
# doesn't make this safer, it just means the next person who finds it
# trusts the rest of this file less.

set -e

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "✗ pre-push: refusing to push to main" >&2
    echo "" >&2
    echo "  main auto-deploys to production (Vercel <-> GitHub integration)." >&2
    echo "  The ruleset 'web' on main also requires a PR; this local check" >&2
    echo "  just saves you the trip to GitHub." >&2
    echo "" >&2
    echo "  Open a PR instead:  gh pr create ...  then  gh pr merge --squash" >&2
    echo "" >&2
    echo "  Bypass (emergencies only): git push --no-verify" >&2
    exit 1
  fi
done

exit 0
